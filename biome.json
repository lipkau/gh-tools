{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/lib", "!**/tests/fixtures"]
  },
  "formatter": {
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "bracketSpacing": false,
      "arrowParentheses": "asNeeded"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true,
      "lineWidth": 100
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error",
        "useTopLevelHeading": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  }
}
