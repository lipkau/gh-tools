{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate settings for lipkau's repositories. Extend with github>lipkau/gh-tools//renovate/default",
  "extends": ["config:best-practices", ":semanticCommits"],
  "minimumReleaseAge": "3 days",
  "timezone": "Europe/Berlin",
  "schedule": ["before 7am on monday"],
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One pull request for every minor, patch and digest update, merged once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true
    },
    {
      "description": "A 0.x release may break anything, so those updates get their own pull request for review",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchCurrentVersion": "/^v?0\\./",
      "groupName": "0.x dependencies",
      "groupSlug": "zerover",
      "automerge": false
    }
  ]
}
